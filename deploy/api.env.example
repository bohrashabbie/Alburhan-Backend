# Copy to deploy/api.env on the server (chmod 600). Never commit the real file.
DJANGO_SETTINGS_MODULE=config.settings.prod
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# The public ERP host, plus "api" for calls from the web container.
DJANGO_ALLOWED_HOSTS=erp.alburhanregional.com,api
CSRF_TRUSTED_ORIGINS=https://erp.alburhanregional.com
# Caddy redirects to HTTPS; Django must not, or the web container's internal http calls break.
DJANGO_SECURE_SSL_REDIRECT=false

# PostgreSQL: a dedicated app user, SSL on. Rotate the development password before go-live.
DATABASE_URL=postgres://alburhan_app:CHANGE_ME@DB_HOST:5432/alburhan_erp?sslmode=require
DB_POOL_MIN=2
DB_POOL_MAX=10

CACHE_URL=redis://redis:6379/1
WEB_CONCURRENCY=3

# Files (logos, product photos, avatars): private S3 bucket, short-lived signed links.
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Same region as the bucket (the current buckets are in eu-north-1).
AWS_REGION=eu-north-1
AWS_STORAGE_BUCKET_NAME=alburhan-erp-private
AWS_LOCATION=erp

# Email for HR leave approvals (Amazon SES SMTP or any SMTP server).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.eu-north-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Al-Burhan ERP <no-reply@alburhanregional.com>
# Links in emails open here.
FRONTEND_URL=https://erp.alburhanregional.com

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
DJANGO_LOG_LEVEL=WARNING
