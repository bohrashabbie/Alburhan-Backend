# Copy to .env and fill in. .env is git-ignored: never commit real credentials.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (use a dedicated app user, not the postgres superuser)
DATABASE_URL=postgres://alburhan_app:PASSWORD@HOST:5432/alburhan_erp

CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# File storage: "s3" in real environments, "local" saves under media/ for development.
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=eu-north-1
AWS_STORAGE_BUCKET_NAME=your-bucket
AWS_LOCATION=erp

# Email for HR leave requests. Without EMAIL_BACKEND, emails print to the server console.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Al-Burhan ERP <no-reply@alburhanregional.com>
# The ERP website address used in email links.
FRONTEND_URL=https://erp.alburhanregional.com
